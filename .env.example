# 네이버 개발자센터 (https://developers.naver.com) 에서 앱 등록 후 발급
NAVER_CLIENT_ID=여기에_Client_ID_입력
NAVER_CLIENT_SECRET=여기에_Client_Secret_입력

# 슬랙 Incoming Webhook URL
# 슬랙 앱 → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/여기에_입력

# ── 콘텐츠 생성기 ────────────────────────────────────────────────────
# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-여기에_입력

# 생성 옵션 (미설정 시 기본값 사용)
CONTENT_MODEL=claude-opus-5
CONTENT_EFFORT=high
CONTENT_MIN_SCORE=80
CONTENT_MAX_REPAIRS=1
CONTENT_PORT=5001

# ── 병원 기본정보 (NAP) ───────────────────────────────────────────────
# 홈페이지·네이버플레이스·구글 비즈니스 프로필과 글자 단위로 동일해야 합니다.
# 비워 두면 JSON-LD에서 빠지고 GEO 점수가 깎입니다.
CLINIC_OFFICIAL_NAME=오블리브 송도 호라이즌의원
CLINIC_UNIT_NAME=문제성발톱클리닉
CLINIC_SHORT_NAME=오블리브의원
CLINIC_REGION=인천광역시
CLINIC_LOCALITY=연수구
CLINIC_STREET=
CLINIC_POSTAL_CODE=
CLINIC_PHONE=
CLINIC_HOURS=Mo-Fr 10:00-19:00, Sa 10:00-14:00
CLINIC_HOMEPAGE=https://obliv.kr
CLINIC_BLOG_BASE=https://blog.obliv.kr/blog
CLINIC_NAVER_PLACE=
CLINIC_GOOGLE_PROFILE=

# E-E-A-T (구글 건강 콘텐츠 평가에 직접 영향)
CLINIC_AUTHOR_NAME=
CLINIC_AUTHOR_TITLE=원장
CLINIC_AUTHOR_CREDENTIAL=의사
CLINIC_REVIEWER_NAME=
CLINIC_REVIEWER_TITLE=원장

# 의료광고 심의번호 (있으면 본문 하단에 자동 표기)
CLINIC_AD_REVIEW_NO=

# ── CMS 자동 업로드 ──────────────────────────────────────────────────
# 로그인 정보는 절대 저장소에 커밋하지 마세요 (.env는 .gitignore에 있습니다)
CMS_WRITE_URL=https://blog.obliv.kr/blogmanage/nxt-blog.php
CMS_LOGIN_URL=
CMS_USERNAME=
CMS_PASSWORD=

# 브라우저 동작 (CMS_HEADLESS=0 이면 창을 띄워 눈으로 확인 가능)
CMS_HEADLESS=1
CMS_TIMEOUT=25

# ── 썸네일 (사진 배경 + 제목 텍스트, 880x580 / 300KB 이하 자동 생성) ──
# 배경 사진 폴더. 카테고리별 하위 폴더를 만들면 자동으로 골라 씁니다.
THUMB_PHOTO_DIR=assets/thumbnails
THUMB_DIR=thumbnails

# 브랜드 로고 - 배경을 지운(누끼) 투명 PNG
THUMB_LOGO=assets/logo.png
THUMB_LOGO_WIDTH=200
# 1이면 로고를 크림색으로 다시 칠합니다(어두운 사진 위에서 읽히도록).
# 원본 색을 그대로 쓰려면 0으로 두세요.
THUMB_LOGO_TINT=1
# 로고가 없을 때 대신 넣을 텍스트
THUMB_BRAND=Obliv Clinic

# 레이아웃: auto(글마다 번갈아) / center(제목 중앙) / bottom(제목 하단)
THUMB_LAYOUT=auto
THUMB_TEXT_COLOR=#F5EBDC
# 사진이 없을 때 쓰는 단색 배경
THUMB_BG=#2b2622
# 글자 뒤 배경을 이 밝기(0~255) 아래로 눌러 가독성을 확보합니다. 낮출수록 어두워집니다.
THUMB_TARGET_LUMA=95

# 폰트 - 비워 두면 명조/세리프 계열을 자동 탐색합니다.
# 윈도우 예: THUMB_FONT_KO=C:\Windows\Fonts\batang.ttc
THUMB_FONT_KO=
THUMB_FONT_EN=

# ── 웹앱 (사내 PC 서버) ──────────────────────────────────────────────
# 접속 비밀번호. 비워 두면 같은 네트워크의 누구나 들어옵니다.
APP_PASSWORD=
# 세션 서명 키. 비워 두면 서버를 재시작할 때마다 로그인이 풀립니다.
# 아무 긴 문자열이나 넣으세요.
APP_SECRET=

CONTENT_HOST=0.0.0.0
CONTENT_PORT=5001
